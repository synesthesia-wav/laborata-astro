{
  "name": "laborata",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "check": "ultracite check",
    "dev": "/opt/homebrew/bin/node ./node_modules/.bin/portless",
    "dev:app": "turbo dev",
    "fix": "ultracite fix",
    "format": "turbo format",
    "postinstall": "node scripts/patch-astro-cookie.mjs || true",
    "lint": "turbo lint",
    "prepare": "lefthook install || true",
    "typecheck": "turbo typecheck"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "minisearch": "^7.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@shadscan/cli": "0.17.0",
    "lefthook": "^2.1.10",
    "portless": "^0.15.6",
    "turbo": "^2.9.18",
    "typescript": "~6",
    "ultracite": "7.10.6"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.12.0"
  },
  "portless": {
    "name": "laborata-astro",
    "script": "dev:app"
  }
}
