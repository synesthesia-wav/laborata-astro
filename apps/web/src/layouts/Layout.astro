---
import "@workspace/ui/globals.css";
import { Toaster } from "@workspace/ui/components/toast";
import { MobileNav } from "../components/layout/mobile-nav";

interface Props {
  canonical?: string;
  description: string;
  lang?: "ro" | "en";
  ogImage?: string;
  title: string;
}

const { title, description, lang = "ro", ogImage, canonical } = Astro.props;
const site = Astro.site?.toString() ?? Astro.url.origin;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site).toString();
---

<html lang={lang}>
  <head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1" name="viewport">
    <title>{title}</title>
    <meta content={description} name="description">
    <link href={canonicalUrl} rel="canonical">
    <meta content={title} property="og:title">
    <meta content={description} property="og:description">
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta content="website" property="og:type">
    <meta content="summary_large_image" name="twitter:card">
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <link href="/favicon.svg" rel="icon" type="image/svg+xml">
    <slot name="head" />
  </head>
  <body class="bg-background text-foreground antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-2 focus:z-50 focus:rounded-xl focus:bg-primary focus:px-3 focus:py-2 focus:text-primary-foreground"
      >Sari la conținut</a
    >
    <header
      class="sticky top-0 z-30 border-b bg-background/80 backdrop-blur supports-backdrop-filter:backdrop-blur-sm"
      role="banner"
    >
      <div
        class="mx-auto flex w-full max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6"
      >
        <a class="font-heading text-sm font-semibold tracking-tight" href="/"
          >Laborata</a
        >
        <nav aria-label="Principal" class="hidden items-center gap-1 md:flex">
          <a
            class="rounded-full px-3 py-1.5 text-xs font-medium hover:bg-muted focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/30"
            href="/analize"
            >Analize</a
          >
          <a
            class="rounded-full px-3 py-1.5 text-xs font-medium hover:bg-muted focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/30"
            href="/laboratoare"
            >Laboratoare</a
          >
          <a
            class="rounded-full px-3 py-1.5 text-xs font-medium hover:bg-muted focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/30"
            href="/harta"
            >Harta</a
          >
          <a
            class="rounded-full px-3 py-1.5 text-xs font-medium hover:bg-muted focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/30"
            href="/liste"
            >Liste</a
          >
          <a
            class="rounded-full px-3 py-1.5 text-xs font-medium hover:bg-muted focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/30"
            href="/comparatie"
            >Compară</a
          >
        </nav>
        <div class="flex items-center gap-2">
          <span class="hidden text-xs text-muted-foreground lg:inline"
            >MDL • Laboratoare acreditate</span
          >
          <a
            class="inline-flex h-8 items-center rounded-full border bg-card px-3 text-xs font-medium hover:bg-muted focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/30"
            href="/analize"
            >Vezi analize</a
          >
          <div class="md:hidden">
            <MobileNav client:load />
          </div>
        </div>
      </div>
    </header>

    <main id="main-content" class="flex w-full min-w-0 flex-col" tabindex="-1">
      <slot />
    </main>

    <footer class="border-t px-4 py-6 text-xs text-muted-foreground sm:px-6">
      <div class="mx-auto flex w-full max-w-7xl flex-col gap-4">
        <nav aria-label="Subsol" class="flex flex-wrap justify-center gap-3">
          <a
            class="underline underline-offset-4 hover:text-foreground"
            href="/analize"
            >Analize</a
          >
          <a
            class="underline underline-offset-4 hover:text-foreground"
            href="/laboratoare"
            >Laboratoare</a
          >
          <a
            class="underline underline-offset-4 hover:text-foreground"
            href="/harta"
            >Harta</a
          >
          <a
            class="underline underline-offset-4 hover:text-foreground"
            href="/liste"
            >Liste</a
          >
          <a
            class="underline underline-offset-4 hover:text-foreground"
            href="/comparatie"
            >Compară</a
          >
        </nav>
        <div class="text-center">
          © {new Date().getFullYear()} Laborata • Date demonstrative — vezi
          lista și compară prețuri. În curând rezervi la
          <a
            class="underline underline-offset-4 hover:text-foreground"
            href="mailto:hello@laborata.md"
            >hello@laborata.md</a
          >
        </div>
      </div>
    </footer>
    <Toaster client:load />
  </body>
</html>
