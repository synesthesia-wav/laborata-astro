---
import { Badge } from "@workspace/ui/components/badge";
import { Button } from "@workspace/ui/components/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@workspace/ui/components/card";
import { Skeleton } from "@workspace/ui/components/skeleton";
import { TestCard } from "@workspace/blocks/test-card";
import StateFrame from "../components/playground/StateFrame.astro";
import PlaygroundLayout from "../layouts/playground.astro";

const unbreakable =
  "https://laborata.md/ro/search/super-long-unbreakable-string-without-spaces-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
const longTitle =
  "Analiză completă a sângelui cu 47 de parametri, inclusiv profilul lipidic extins și raport detaliat — hemoleucogramă, VSH, protrombină, fibrinogen și markeri inflamatori cronici";
const longDescription =
  "Rezultatele sunt disponibile în 24–48 ore lucrătoare, cu interpretare clinică și recomandări personalizate. Proba: sânge venos à jeun.";
---

<PlaygroundLayout title="Laborata — Single Test Card" description="Showcase for TestCard — light only. Every state side-by-side with unique ids.">
  <div class="flex min-w-0 flex-col gap-8">
    <div class="flex flex-col gap-2 rounded-xl border bg-card p-5 shadow-sm">
      <h2 class="font-heading text-lg font-semibold tracking-tight">Single Test Card — showcase</h2>
      <p class="max-w-3xl text-sm leading-relaxed text-muted-foreground">
        One real component — <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">TestCard</code> from
        <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">@workspace/blocks/test-card</code>
        — with real tokens via <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">globals.css</code>.
        Light only. Each frame has a unique <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">id</code>. Test at <strong>320px</strong> and desktop.
      </p>
    </div>

    <div class="flex min-w-0 flex-col gap-2">
      <h2 class="font-heading text-xs font-semibold uppercase tracking-widest text-muted-foreground">320px + breakpoints</h2>
      <div class="grid min-w-0 gap-4 md:grid-cols-3">
        <StateFrame description="If this overflows, fails shadscan --check-ui at 320x820." id="testcard-bp-320" title="320px clamped" width="320px">
          <TestCard id="testcard-bp-320-card" title={longTitle} description={longDescription} priceMdl={1250} vendor="Synevo" />
        </StateFrame>
        <StateFrame description="Mid breakpoint — grid reflows." id="testcard-bp-768" title="768px card" width="768px">
          <div class="grid grid-cols-2 gap-3">
            <TestCard id="testcard-bp-768-a" title="Hemoleucogramă" description="47 parametri" priceMdl={320} vendor="Synevo" />
            <TestCard id="testcard-bp-768-b" title="Profil lipidic" description="8 parametri" priceMdl={480} vendor="Invitro" />
          </div>
        </StateFrame>
        <StateFrame description="Desktop — no document horizontal scroll." id="testcard-bp-1440" title="1440px wide" width="100%">
          <div class="flex items-center justify-between gap-4 rounded-lg border bg-muted/50 p-3">
            <span class="text-sm font-medium">1440px shell is max-w-[1600px] + px-6.</span><Badge variant="secondary">OK</Badge>
          </div>
        </StateFrame>
      </div>
    </div>

    <div class="flex min-w-0 flex-col gap-3">
      <h2 class="font-heading text-sm font-semibold">No data / One / Many</h2>
      <div class="grid min-w-0 gap-4 lg:grid-cols-3">
        <StateFrame description="Empty — no test to show." id="testcard-empty-none" title="No data — Empty">
          <div class="flex flex-col items-center gap-3 rounded-xl border border-dashed p-6 text-center">
            <div class="flex size-10 items-center justify-center rounded-full bg-muted text-muted-foreground">⌕</div>
            <p class="text-sm font-medium">Nu există analize</p>
            <p class="text-xs text-muted-foreground">Lista ta este goală.</p>
            <Button size="sm" client:load>Adaugă analiză</Button>
          </div>
        </StateFrame>
        <StateFrame id="testcard-one" title="One — TestCard">
          <TestCard id="testcard-one-card" title="Vitamina D 25-OH" description="Sânge venos • 1 zi" priceMdl={290} vendor="Synevo" />
        </StateFrame>
        <StateFrame id="testcard-many" title="Many — 6 cards, gap-based">
          <div class="grid gap-3 sm:grid-cols-2">
            {Array.from({ length: 6 }).map((_, i) => (
              <TestCard id={`testcard-many-${i}`} title={`Analiză ${i + 1}`} description="Descriere scurtă" priceMdl={120 + i * 40} vendor="Synevo" />
            ))}
          </div>
        </StateFrame>
      </div>
    </div>

    <div class="flex min-w-0 flex-col gap-3">
      <h2 class="font-heading text-sm font-semibold">Loading / Error / Disabled / Permission-denied</h2>
      <div class="grid min-w-0 gap-4 lg:grid-cols-4">
        <StateFrame id="testcard-loading" title="Loading — Skeleton">
          <TestCard id="testcard-loading-card" title="Se încarcă" loading />
        </StateFrame>
        <StateFrame id="testcard-error" title="Error — retry present">
          <TestCard id="testcard-error-card" title="TSH" error="Nu am putut încărca prețurile" onRetry={() => {}} />
        </StateFrame>
        <StateFrame id="testcard-disabled" title="Disabled — no duplicate submit">
          <TestCard id="testcard-disabled-card" title="Glucoză serică" description="Sânge venos" priceMdl={120} disabled />
        </StateFrame>
        <StateFrame id="testcard-permission-denied" title="Permission-denied">
          <TestCard id="testcard-permission-card" title="Hemoleucogramă" permissionDenied />
        </StateFrame>
      </div>
    </div>

    <div class="flex min-w-0 flex-col gap-3">
      <h2 class="font-heading text-sm font-semibold">Text stress — normal / very long / unbreakable</h2>
      <div class="grid min-w-0 gap-4 lg:grid-cols-3">
        <StateFrame id="testcard-text-normal" title="Normal">
          <TestCard id="testcard-text-normal-card" title="Glucoză serică" description={longDescription} priceMdl={120} vendor="Synevo" />
        </StateFrame>
        <StateFrame id="testcard-text-very-long" title="Very long — truncates, button stays">
          <TestCard id="testcard-text-very-long-card" title={longTitle} description="Hemoleucograma completă cu formulă leucocitară detaliată, interpretare hematologică și corelare cu tabloul clinic al pacientului în contextul investigațiilor de rutină." priceMdl={1250} vendor="Synevo" />
        </StateFrame>
        <StateFrame id="testcard-text-unbreakable" title="Unbreakable — break-all, no overflow">
          <TestCard id="testcard-text-unbreakable-card" title={unbreakable} description="link-ul nu trebuie să împingă butonul în afara ecranului la 320px" priceMdl={120} vendor="Synevo" />
        </StateFrame>
      </div>
    </div>

    <div class="flex min-w-0 flex-col gap-3">
      <h2 class="font-heading text-sm font-semibold">Missing image / Very large number / Incomplete data</h2>
      <div class="grid min-w-0 gap-4 lg:grid-cols-3">
        <StateFrame id="testcard-missing-image" title="Missing image — fallback">
          <TestCard id="testcard-missing-image-card" title="Synevo" description="Logo lipsă → fallback vizibil" priceMdl={290} vendor="Synevo" />
        </StateFrame>
        <StateFrame id="testcard-missing-image-empty" title="Missing image — src empty">
          <TestCard id="testcard-missing-image-empty-card" title="Invitro" description="src gol" priceMdl={310} vendor="Invitro" imageSrc="" />
        </StateFrame>
        <StateFrame id="testcard-large-number" title="Very large number — Badge, no raw color">
          <TestCard id="testcard-large-number-card" title="Total coș" description="1 234 567 MDL nu sparge layout-ul" priceMdl={1234567} vendor="Alfa" />
        </StateFrame>
      </div>
    </div>

    <div class="flex min-w-0 flex-col gap-3">
      <h2 class="font-heading text-sm font-semibold">Incomplete data</h2>
      <div class="grid min-w-0 gap-4 lg:grid-cols-2">
        <StateFrame id="testcard-incomplete" title="Incomplete — graceful">
          <TestCard id="testcard-incomplete-card" title="TSH" description="Proba: — • Termen: necunoscut" priceMdl={null} vendor="Synevo" />
        </StateFrame>
        <StateFrame id="testcard-incomplete-no-vendor" title="Incomplete — no vendor">
          <TestCard id="testcard-incomplete-no-vendor-card" title="TSH" description="Fără laborator" priceMdl={null} />
        </StateFrame>
      </div>
    </div>

    <div class="flex min-w-0 flex-col gap-3">
      <h2 class="font-heading text-sm font-semibold">Skeleton & Badge checks</h2>
      <div class="grid min-w-0 gap-4 lg:grid-cols-2">
        <StateFrame id="testcard-skeleton-detail" title="Skeleton detail">
          <Card className="min-w-0">
            <CardHeader>
              <div class="flex items-center gap-3">
                <Skeleton className="size-10 rounded-full" />
                <div class="flex flex-col gap-2"><Skeleton className="h-3 w-24" /><Skeleton className="h-3 w-32" /></div>
              </div>
            </CardHeader>
            <CardContent><Skeleton className="h-8 w-full rounded-lg" /></CardContent>
          </Card>
        </StateFrame>
        <StateFrame id="testcard-badge-large" title="Badge large number">
          <div class="flex items-center justify-between gap-2">
            <span class="text-sm text-muted-foreground">Economie</span><Badge variant="secondary">+ 89 432 MDL</Badge>
          </div>
        </StateFrame>
      </div>
    </div>
  </div>
</PlaygroundLayout>
