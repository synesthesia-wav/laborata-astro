---
import "@workspace/ui/globals.css";
import { BRANCHES } from "@workspace/data/branches";
import { TESTS } from "@workspace/data/canonical";
import {
  Alert,
  AlertDescription,
  AlertTitle,
} from "@workspace/ui/components/alert";
import { Badge } from "@workspace/ui/components/badge";
import { Button } from "@workspace/ui/components/button";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@workspace/ui/components/card";
import {
  Empty,
  EmptyDescription,
  EmptyHeader,
  EmptyMedia,
  EmptyTitle,
} from "@workspace/ui/components/empty";
import { Separator } from "@workspace/ui/components/separator";
import { Skeleton } from "@workspace/ui/components/skeleton";
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@workspace/ui/components/table";
import {
  PRICE_OFFERS_LARGE,
  PRICE_OFFERS_SINGLE,
  PRICE_OFFERS_VARIANT,
  PRODUCT_GALLERY,
} from "../components/product/data";
import { Faq } from "../components/product/faq";
import { PriceComparison } from "../components/product/price-comparison";
import { ProductGallery } from "../components/product/product-gallery";
import { ProductHeader } from "../components/product/product-header";
import { ProductSpecs } from "../components/product/product-specs";
---

<html lang="ro">
  <head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1" name="viewport">
    <meta
      content="Showcase — stări Laborata PDP Vitamina B12"
      name="description"
    >
    <link href="/favicon.svg" rel="icon" type="image/svg+xml">
    <title>Laborata — Showcase</title>
  </head>
  <body class="bg-background text-foreground antialiased">
    <header class="sticky top-0 z-10 border-b bg-background/80 backdrop-blur">
      <div
        class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6"
      >
        <div class="min-w-0">
          <h1
            class="truncate font-heading text-sm font-semibold tracking-tight"
          >
            Laborata — Showcase
          </h1>
          <p class="truncate text-xs text-muted-foreground">
            PDP Vitamina B12 — minimal · 5 secțiuni · Paper assets · price truth
            W2
          </p>
        </div>
        <div class="flex gap-2">
          <a
            class="inline-flex h-8 items-center rounded-full border bg-card px-3 text-xs font-medium hover:bg-muted"
            href="/analize/vitamina-b12"
            >Deschide PDP</a
          >
          <a
            class="inline-flex h-8 items-center rounded-full border bg-card px-3 text-xs font-medium hover:bg-muted"
            href="/"
            >Home</a
          >
        </div>
      </div>
    </header>

    <main
      class="mx-auto flex w-full max-w-7xl min-w-0 flex-col gap-8 p-4 sm:p-6"
    >
      <Card>
        <CardHeader>
          <CardTitle className="text-lg"
            >Matrice stări — PDP minimal (W2 price truth)</CardTitle
          >
          <CardDescription>
            Păstrate 5 secțiuni: galerie 1:1, header single price (lowest +
            priceAsOf + provenance), specs per-vendor onest, comparație prețuri
            single fee (5 labs), FAQ. Fără
            Plan/Trust/Testimoniale/HowItWorks/Interpretation/Related. Fiecare
            instanță are
            <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs"
              >idSuffix</code
            >
            unic — fără duplicate ARIA.
          </CardDescription>
        </CardHeader>
      </Card>

      <section class="flex flex-col gap-4">
        <h2 class="font-heading text-sm font-semibold tracking-tight">
          ProductGallery — 1:1, fără badges
        </h2>
        <div class="grid gap-4 md:grid-cols-3">
          <Card size="sm">
            <CardHeader
              ><CardTitle className="text-sm">Loading</CardTitle
              ><CardDescription
                >Skeleton aspect-square</CardDescription
              ></CardHeader
            >
            <CardContent
              ><ProductGallery
                idSuffix="showcase-loading"
                images={[]}
                loading={true}
                client:load
              /></CardContent
            >
          </Card>
          <Card size="sm">
            <CardHeader
              ><CardTitle className="text-sm">Fără imagine</CardTitle
              ><CardDescription
                >Empty aspect-square</CardDescription
              ></CardHeader
            >
            <CardContent
              ><ProductGallery
                idSuffix="showcase-empty"
                images={[]}
                client:load
              /></CardContent
            >
          </Card>
          <Card size="sm">
            <CardHeader
              ><CardTitle className="text-sm">Una</CardTitle
              ><CardDescription>Single 1:1</CardDescription></CardHeader
            >
            <CardContent
              ><ProductGallery
                idSuffix="showcase-one"
                images={[PRODUCT_GALLERY[0]]}
                client:load
              /></CardContent
            >
          </Card>
        </div>
        <Card>
          <CardHeader
            ><CardTitle className="text-sm"
              >Multe (3) + carousel 1:1</CardTitle
            ></CardHeader
          >
          <CardContent
            ><ProductGallery
              idSuffix="showcase-many"
              images={PRODUCT_GALLERY}
              client:load
            /></CardContent
          >
        </Card>
        <Card>
          <CardHeader
            ><CardTitle className="text-sm"
              >Eroare + retry</CardTitle
            ></CardHeader
          >
          <CardContent className="flex flex-col gap-3">
            <Alert variant="destructive">
              <AlertTitle>Eroare la încărcarea imaginilor</AlertTitle>
              <AlertDescription>Nu am putut încărca galeria.</AlertDescription>
            </Alert>
            <Button size="sm" variant="outline">Reîncearcă</Button>
          </CardContent>
        </Card>
      </section>

      <Separator />

      <section class="flex flex-col gap-4">
        <h2 class="font-heading text-sm font-semibold tracking-tight">
          ProductHeader — lowest price_mdl + priceAsOf + provenance (33 lei demo
          → 175 lei onest)
        </h2>
        <div class="grid gap-4 lg:grid-cols-3">
          <Card
            ><CardHeader
              ><CardTitle className="text-sm">Loading</CardTitle></CardHeader
            ><CardContent
              ><ProductHeader
                idSuffix="showcase-h-loading"
                loading={true}
                client:load
              /></CardContent
            ></Card
          >
          <Card
            ><CardHeader
              ><CardTitle className="text-sm">Disabled</CardTitle
              ><CardDescription>Buton dezactivat</CardDescription></CardHeader
            ><CardContent
              ><ProductHeader
                disabled={true}
                idSuffix="showcase-h-disabled"
                client:load
              /></CardContent
            ></Card
          >
          <Card
            ><CardHeader
              ><CardTitle className="text-sm">Normal — 175 lei sub h1</CardTitle
              ><CardDescription
                >cel mai mic din 4/5</CardDescription
              ></CardHeader
            ><CardContent
              ><ProductHeader
                idSuffix="showcase-h-normal"
                client:load
              /></CardContent
            ></Card
          >
        </div>
        <div class="grid gap-4 lg:grid-cols-3">
          <Card>
            <CardHeader
              ><CardTitle className="text-sm">Permission denied</CardTitle
              ><CardDescription>stare showcase W4</CardDescription></CardHeader
            >
            <CardContent
              ><ProductHeader
                idSuffix="showcase-h-permission"
                permissionDenied={true}
                client:load
              /></CardContent
            >
          </Card>
          <Card>
            <CardHeader
              ><CardTitle className="text-sm">Large 1.250.000 lei</CardTitle
              ><CardDescription>wrapping preț mare</CardDescription></CardHeader
            >
            <CardContent
              ><ProductHeader
                idSuffix="showcase-h-large"
                lowestPrice={1_250_000}
                client:load
              /></CardContent
            >
          </Card>
          <Card>
            <CardHeader
              ><CardTitle className="text-sm">Variant — 24-ore</CardTitle
              ><CardDescription>qualifier</CardDescription></CardHeader
            >
            <CardContent
              ><ProductHeader
                idSuffix="showcase-h-variant"
                variant="24-ore"
                client:load
              /></CardContent
            >
          </Card>
        </div>
        <Card>
          <CardHeader
            ><CardTitle className="text-sm"
              >Text foarte lung / nedespărțit</CardTitle
            ><CardDescription
              >Verifică truncate 1:1 · 320px</CardDescription
            ></CardHeader
          >
          <CardContent className="flex flex-col gap-4">
            <div class="rounded-lg border p-4">
              <h3 class="text-balance font-heading text-xl font-semibold">
                Vitamina B12 (Cobalamină) cu denumire extrem de lungă pentru
                wrapping pe 320px
              </h3>
              <p class="mt-2 break-all text-sm text-muted-foreground">
                SupercalifragilisticexpialidociousVitaminaB12CobalaminăTestDeSângeCuNumeFoarteLungCuVariantCantitativ24Ore
              </p>
              <div class="mt-2 flex flex-wrap gap-2">
                <Badge>999.999 lei</Badge
                ><Badge variant="outline">175 lei</Badge
                ><Badge variant="secondary">1.250.000 lei</Badge>
              </div>
            </div>
            <Alert
              ><AlertTitle>Număr mare</AlertTitle
              ><AlertDescription
                >Preț <span class="font-mono font-medium">1.250.000 lei</span> —
                wrapping preț (ro-RO grouping).</AlertDescription
              ></Alert
            >
          </CardContent>
        </Card>
      </section>

      <Separator />

      <section class="flex flex-col gap-4">
        <h2 class="font-heading text-sm font-semibold tracking-tight">
          ProductSpecs — per-vendor onest (91% specimen 69% method 93% TAT 53%
          protocol 6.9% refs) · Synevo 1 zi · Sante 14 zile
        </h2>
        <div class="grid gap-4 lg:grid-cols-2">
          <Card
            ><CardHeader
              ><CardTitle className="text-sm"
                >Specs — loading</CardTitle
              ></CardHeader
            ><CardContent
              ><ProductSpecs
                idSuffix="showcase-specs-loading"
                loading={true}
                client:load
              /></CardContent
            ></Card
          >
          <Card
            ><CardHeader
              ><CardTitle className="text-sm"
                >Specs — collapsible normal</CardTitle
              ><CardDescription
                >Citește mai mult / mai puțin (honest null)</CardDescription
              ></CardHeader
            ><CardContent
              ><ProductSpecs
                idSuffix="showcase-specs-normal"
                client:load
              /></CardContent
            ></Card
          >
        </div>
        <div class="grid gap-4 lg:grid-cols-2">
          <Card
            ><CardHeader
              ><CardTitle className="text-sm">Specs — disabled</CardTitle
              ><CardDescription>W4 missing state</CardDescription></CardHeader
            ><CardContent
              ><ProductSpecs
                disabled={true}
                idSuffix="showcase-specs-disabled"
                client:load
              /></CardContent
            ></Card
          >
          <Card
            ><CardHeader
              ><CardTitle className="text-sm"
                >Specs — permission denied</CardTitle
              ><CardDescription>W4 missing state</CardDescription></CardHeader
            ><CardContent
              ><ProductSpecs
                idSuffix="showcase-specs-permission"
                permissionDenied={true}
                client:load
              /></CardContent
            ></Card
          >
        </div>
      </section>

      <Separator />

      <section class="flex flex-col gap-4">
        <h2 class="font-heading text-sm font-semibold tracking-tight">
          PriceComparison — single fee line (5 labs Synevo Sante Invitro
          MedExpert Alfa) · plus 30 lei o singură dată / 0 lei — inclus
        </h2>
        <div class="grid gap-4 lg:grid-cols-2">
          <Card
            ><CardHeader
              ><CardTitle className="text-sm">Loading</CardTitle></CardHeader
            ><CardContent
              ><PriceComparison
                idSuffix="pc-loading"
                loading={true}
                client:load
              /></CardContent
            ></Card
          >
          <Card>
            <CardHeader
              ><CardTitle className="text-sm"
                >Eroare prețuri + retry</CardTitle
              ></CardHeader
            >
            <CardContent className="flex flex-col gap-3">
              <Skeleton className="h-32 w-full" />
              <Alert variant="destructive"
                ><AlertTitle>Nu am putut încărca prețurile</AlertTitle
                ><AlertDescription>Reîncearcă.</AlertDescription></Alert
              >
              <Button size="sm" variant="outline">Reîncearcă</Button>
            </CardContent>
          </Card>
        </div>

        <div class="grid gap-4 lg:grid-cols-2">
          <Card>
            <CardHeader
              ><CardTitle className="text-sm"
                >0 vendors — Not available</CardTitle
              ><CardDescription>empty state honest</CardDescription></CardHeader
            >
            <CardContent
              ><PriceComparison
                idSuffix="pc-empty"
                offers={[]}
                client:load
              /></CardContent
            >
          </Card>
          <Card>
            <CardHeader
              ><CardTitle className="text-sm">1/5 vendors</CardTitle
              ><CardDescription
                >single offer · cheapest highlight</CardDescription
              ></CardHeader
            >
            <CardContent
              ><PriceComparison
                idSuffix="pc-single"
                offers={PRICE_OFFERS_SINGLE}
                client:load
              /></CardContent
            >
          </Card>
        </div>

        <PriceComparison idSuffix="pc-default-4of5" client:load />

        <div class="grid gap-4 lg:grid-cols-2">
          <Card>
            <CardHeader
              ><CardTitle className="text-sm"
                >Large — 1.250.000 lei row</CardTitle
              ><CardDescription
                >ro-RO grouping stress</CardDescription
              ></CardHeader
            >
            <CardContent
              ><PriceComparison
                idSuffix="pc-large"
                offers={PRICE_OFFERS_LARGE}
                client:load
              /></CardContent
            >
          </Card>
          <Card>
            <CardHeader
              ><CardTitle className="text-sm">Variant qualifier</CardTitle
              ><CardDescription
                >24-ore / cantitativ badge</CardDescription
              ></CardHeader
            >
            <CardContent
              ><PriceComparison
                idSuffix="pc-variant"
                offers={PRICE_OFFERS_VARIANT}
                client:load
              /></CardContent
            >
          </Card>
        </div>

        <Card className="border-dashed">
          <CardHeader>
            <CardTitle className="text-sm"
              >N of M — 0/4 panel archetype (bundle) · gray</CardTitle
            >
            <CardDescription
              >Profil / bundle state — not yet sold as bundle here (never
              invent)</CardDescription
            >
          </CardHeader>
          <CardContent className="flex flex-col gap-3">
            <div class="rounded-lg border bg-muted/20 p-4">
              <div class="flex items-center justify-between gap-2">
                <span class="font-medium text-sm"
                  >Profil tiroidian — 0/4 analize disponibile</span
                >
                <Badge variant="secondary">0/4</Badge>
              </div>
              <p class="mt-2 text-muted-foreground text-xs leading-relaxed">
                Sante 0/4 · Synevo 1/4 · Invitro 0/4 — Not yet sold as a bundle
                here. Quorum ≥2, archetype referenceComponentIds honest.
              </p>
              <div class="mt-3 grid grid-cols-4 gap-2 text-xs">
                <div
                  class="rounded border bg-card px-2 py-2 text-center text-muted-foreground"
                >
                  TSH · —
                </div>
                <div
                  class="rounded border bg-card px-2 py-2 text-center text-muted-foreground"
                >
                  FT4 · —
                </div>
                <div
                  class="rounded border bg-card px-2 py-2 text-center text-muted-foreground"
                >
                  FT3 · —
                </div>
                <div
                  class="rounded border bg-card px-2 py-2 text-center text-muted-foreground"
                >
                  Anti-TPO · —
                </div>
              </div>
            </div>
            <p class="text-muted-foreground text-xs">
              Stare showcase W2: N of M 0/4 gray — honest null, nu inventăm
              bundle.
            </p>
          </CardContent>
        </Card>

        <Card className="border-dashed">
          <CardHeader>
            <CardTitle className="text-sm">EN — 270 MDL grouped</CardTitle
            ><CardDescription
              >270 lei (RO) / 270 MDL (EN) grouped check</CardDescription
            >
          </CardHeader>
          <CardContent
            ><PriceComparison
              idSuffix="pc-en"
              lang="en"
              priceAsOf="August 2026"
              client:load
            /></CardContent
          >
        </Card>
      </section>

      <Separator />

      <Faq idSuffix="showcase-faq" client:load />

      <Separator />

      <!-- W3 List matrix — soft 12, idSuffix isolated -->
      <section class="flex flex-col gap-4">
        <div class="flex flex-col gap-1">
          <h2 class="font-heading text-sm font-semibold tracking-tight">
            List — soft 12 • Analizele mele / Mama control anual • share
            ?share=token &lt;2k
          </h2>
          <p class="text-muted-foreground text-xs leading-relaxed">
            empty / one / many (12) / 13 soft non-blocking warning. anonToken
            localStorage, ulid, base64(JSON) token. Fiecare instanță idSuffix
            izolat, fără duplicate ARIA.
          </p>
        </div>
        <div class="grid gap-4 lg:grid-cols-2">
          <!-- empty -->
          <Card id="showcase-list-empty">
            <CardHeader
              ><CardTitle className="text-sm"
                >Empty — Analizele mele (0)</CardTitle
              ><CardDescription
                >id: 01LISTEMPTY • owner anonToken • 0/12</CardDescription
              ></CardHeader
            >
            <CardContent>
              <Empty className="border border-dashed">
                <EmptyHeader
                  ><EmptyMedia variant="icon">📋</EmptyMedia
                  ><EmptyTitle>No tests yet</EmptyTitle
                  ><EmptyDescription
                    >Add from search or bundle. Share link needs &lt;2k
                    token.</EmptyDescription
                  ></EmptyHeader
                >
              </Empty>
            </CardContent>
          </Card>
          <!-- one -->
          <Card id="showcase-list-one">
            <CardHeader
              ><CardTitle className="text-sm"
                >One — Mama control anual (1)</CardTitle
              ><CardDescription
                >id: 01LISTONE • 1/12 • pinnedBranch optional</CardDescription
              ></CardHeader
            >
            <CardContent className="flex flex-col gap-2">
              <div
                class="flex items-center justify-between rounded-lg border bg-card px-3 py-2 text-sm"
                id="showcase-list-one-item"
              >
                <span>{TESTS[0]?.id ?? "tsh"}</span
                ><Badge variant="secondary">remove</Badge>
              </div>
              <div class="text-muted-foreground text-xs">
                Share:
                <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs"
                  >?share=eyJ2IjoxLCJpZCI6IjAxIn0</code
                >
                base64 &lt;2k
              </div>
            </CardContent>
          </Card>
        </div>
        <div class="grid gap-4 lg:grid-cols-2">
          <Card id="showcase-list-12">
            <CardHeader
              ><CardTitle className="text-sm"
                >Many — 12/12 soft limit • Analizele mele (12)</CardTitle
              ><CardDescription
                >Inline compară pe /liste/[id] — overflow-x-auto sticky Test
                col</CardDescription
              ></CardHeader
            >
            <CardContent className="flex flex-col gap-2">
              <div class="grid grid-cols-3 gap-2">
                {TESTS.slice(0,12).map((t) => (
                  <div id={`showcase-12-${t.id}`} class="truncate rounded border bg-muted/20 px-2 py-1.5 text-xs">{t.id}</div>
                ))}
              </div>
              <div class="text-xs text-muted-foreground">
                12 tests • cheapestSingleLab Synevo total fee-included (plus 30
                lei o singură dată)
              </div>
            </CardContent>
          </Card>
          <Card className="border-amber-200" id="showcase-list-13">
            <CardHeader
              ><CardTitle className="text-sm"
                >13th — soft warning non-blocking</CardTitle
              ><CardDescription
                >13/12 • List mare — compararea poate fi lungă, împarte în
                două?</CardDescription
              ></CardHeader
            >
            <CardContent className="flex flex-col gap-3">
              <div class="grid grid-cols-3 gap-2">
                {TESTS.slice(0,13).map((t) => (
                  <div id={`showcase-13-${t.id}`} class="truncate rounded border bg-muted/20 px-2 py-1.5 text-xs">{t.id}</div>
                ))}
              </div>
              <Alert
                ><AlertTitle>List mare</AlertTitle
                ><AlertDescription
                  >Compararea a 13+ teste poate fi lungă, împarte în două? —
                  warning, no hard throw. 13th still allowed.</AlertDescription
                ></Alert
              >
            </CardContent>
          </Card>
        </div>
        <div class="grid gap-4 lg:grid-cols-3">
          <Card id="showcase-list-loading"
            ><CardHeader
              ><CardTitle className="text-sm"
                >Loading Skeleton</CardTitle
              ></CardHeader
            ><CardContent
              ><Skeleton className="h-24 w-full" /></CardContent
            ></Card
          >
          <Card className="border-destructive/50" id="showcase-list-error"
            ><CardHeader
              ><CardTitle className="text-sm text-destructive"
                >Error + retry</CardTitle
              ><CardDescription
                >Could not load lists</CardDescription
              ></CardHeader
            ><CardContent
              ><Button size="sm" variant="outline">Retry</Button></CardContent
            ></Card
          >
          <Card id="showcase-list-disabled"
            ><CardHeader
              ><CardTitle className="text-sm"
                >Disabled • share read-only</CardTitle
              ><CardDescription
                >?share token opens without account</CardDescription
              ></CardHeader
            ><CardContent
              ><Button disabled size="sm" variant="outline"
                >Share link read-only</Button
              ></CardContent
            ></Card
          >
        </div>
        <Card className="overflow-hidden" id="showcase-list-long">
          <CardHeader
            ><CardTitle className="text-sm"
              >Very long / unbreakable name</CardTitle
            ></CardHeader
          >
          <CardContent className="flex flex-col gap-2">
            <div class="break-all rounded border bg-card px-3 py-2 text-xs">
              SupercalifragilisticexpialidociousVitaminaB12CobalaminăTestDeSângeCuNumeFoarteLungSiFaraSpatiiCaSaTestamOverflow320px
            </div>
            <div class="truncate rounded border bg-card px-3 py-2 text-xs">
              Mama — control anual cu colesterol, trigliceride, hemoleucograma
              completă 5 diff și vitamina D 25-OH
            </div>
          </CardContent>
        </Card>
      </section>

      <Separator />

      <!-- W3 Comparison matrix — 1/12 tests, 12×5=60 cells, overflow-x-auto sticky -->
      <section class="flex flex-col gap-4">
        <div class="flex flex-col gap-1">
          <h2 class="font-heading text-sm font-semibold tracking-tight">
            Comparison — soft 12 • inline on liste/[id] • standalone /comparatie
            • fee-included
          </h2>
          <p class="text-muted-foreground text-xs leading-relaxed">
            ≤12 free, overflow-x-auto + sticky Test col. cheapestSingleLab
            &#123;labId,total&#125; fee-included + saveIfSplit without push.
          </p>
        </div>
        <!-- 1 test -->
        <Card id="showcase-compare-1">
          <CardHeader
            ><CardTitle className="text-sm">1 test — single row</CardTitle
            ><CardDescription
              >Cheapest single-lab: Synevo 260 lei total (fees included) • Save
              18 lei if split — without push</CardDescription
            ></CardHeader
          >
          <CardContent className="overflow-x-auto">
            <Table>
              <TableHeader
                ><TableRow
                  ><TableHead className="sticky left-0 bg-card px-3"
                    >Test</TableHead
                  ><TableHead className="px-3">Synevo</TableHead
                  ><TableHead className="px-3">Sante</TableHead
                  ><TableHead className="px-3">Invitro</TableHead
                  ><TableHead className="px-3">MedExpert</TableHead
                  ><TableHead className="px-3">Alfa</TableHead></TableRow
                ></TableHeader
              >
              <TableBody
                ><TableRow
                  ><TableCell className="sticky left-0 bg-card px-3 font-medium"
                    >{TESTS[3]?.id ?? "tsh"}</TableCell
                  ><TableCell className="px-3">120 lei</TableCell
                  ><TableCell className="px-3">110 lei</TableCell
                  ><TableCell className="px-3">135 lei</TableCell
                  ><TableCell className="px-3">—</TableCell
                  ><TableCell className="px-3">98 lei</TableCell></TableRow
                ></TableBody
              >
            </Table>
          </CardContent>
        </Card>
        <!-- 12 tests 60 cells -->
        <Card className="overflow-hidden" id="showcase-compare-12">
          <CardHeader
            ><CardTitle className="text-sm"
              >12 tests • 12×5=60 cells • overflow-x-auto sticky Test
              col</CardTitle
            ><CardDescription
              >Horizontal scroll, first col sticky. Count branches:
              {BRANCHES.length}
              • fee single line</CardDescription
            ></CardHeader
          >
          <CardContent className="overflow-x-auto">
            <Table>
              <TableHeader
                ><TableRow
                  ><TableHead className="sticky left-0 z-10 bg-muted/50 px-3"
                    >Test</TableHead
                  ><TableHead className="px-3">Synevo</TableHead
                  ><TableHead className="px-3">Sante</TableHead
                  ><TableHead className="px-3">Invitro</TableHead
                  ><TableHead className="px-3">MedExpert</TableHead
                  ><TableHead className="px-3">Alfa</TableHead></TableRow
                ></TableHeader
              >
              <TableBody>
                {TESTS.slice(0,12).map((t) => (
                  <TableRow key={t.id}><TableCell className="sticky left-0 z-10 bg-card px-3 font-medium">{t.id}</TableCell><TableCell className="px-3">120</TableCell><TableCell className="px-3">110</TableCell><TableCell className="px-3">135</TableCell><TableCell className="px-3">708</TableCell><TableCell className="px-3">—</TableCell></TableRow>
                ))}
              </TableBody>
            </Table>
          </CardContent>
        </Card>
        <div class="grid gap-4 lg:grid-cols-3">
          <Card id="showcase-compare-loading"
            ><CardHeader
              ><CardTitle className="text-sm">Loading</CardTitle></CardHeader
            ><CardContent
              ><Skeleton className="h-24 w-full" /></CardContent
            ></Card
          >
          <Card className="border-destructive/50" id="showcase-compare-error"
            ><CardHeader
              ><CardTitle className="text-sm text-destructive"
                >Error Alert + retry</CardTitle
              ></CardHeader
            ><CardContent className="flex flex-col gap-2"
              ><Alert variant="destructive"
                ><AlertTitle>Could not load comparison</AlertTitle
                ><AlertDescription>Retry comparison.</AlertDescription></Alert
              ><Button size="sm" variant="outline">Retry</Button></CardContent
            ></Card
          >
          <Card className="border-dashed" id="showcase-compare-empty"
            ><CardHeader
              ><CardTitle className="text-sm">Empty comparison</CardTitle
              ><CardDescription
                >No tests selected — add 1–12</CardDescription
              ></CardHeader
            ><CardContent
              ><Empty
                ><EmptyHeader
                  ><EmptyTitle>No tests to compare</EmptyTitle
                  ><EmptyDescription
                    >Kindly widen — add from Analizele mele.</EmptyDescription
                  ></EmptyHeader
                ></Empty
              ></CardContent
            ></Card
          >
        </div>
        <Card id="showcase-compare-large-price">
          <CardHeader
            ><CardTitle className="text-sm"
              >Large price 1.250.000 lei + long name</CardTitle
            ></CardHeader
          >
          <CardContent className="flex flex-col gap-2"
            ><div class="break-all font-mono text-sm font-medium">
              1.250.000 lei
            </div>
            <div class="break-all text-xs text-muted-foreground">
              SupercalifragilisticexpialidociousTestCuNumeFoarteLungPentruOverflow320pxSi5LabsCuPreturiMari
            </div></CardContent
          >
        </Card>
        <Card id="showcase-branches">
          <CardHeader
            ><CardTitle className="text-sm"
              >Branches — 12 branches match</CardTitle
            ><CardDescription
              >Filter lab×sample×streetKey botanica/centru • Open now • phone •
              sampleTypes • geo lat/lng</CardDescription
            ></CardHeader
          >
          <CardContent className="flex flex-col gap-2 text-xs">
            <div class="flex flex-wrap gap-2">
              <Badge>botanica</Badge><Badge variant="outline">centru</Badge
              ><Badge variant="secondary">Sânge</Badge
              ><Badge variant="outline">Urină</Badge>
            </div>
            <div class="text-muted-foreground">
              12 branches match •
              {BRANCHES.filter(b=>b.streetKey==="botanica").length}
              botanica •
              {BRANCHES.filter(b=>b.streetKey==="centru").length}
              centru
            </div>
            <div class="font-mono">
              Example: {BRANCHES[0]?.address ?? "—"} •
              {BRANCHES[0]?.phone ?? "—"}
              •
              {BRANCHES[0]?.sampleTypes.join(", ")}
            </div>
          </CardContent>
        </Card>
      </section>

      <Separator />

      <Card className="border-dashed">
        <CardHeader>
          <CardTitle className="text-sm">Breakpoints & esențial</CardTitle>
          <CardDescription
            >Secțiuni păstrate: Hero 1:1, Header (lowest+provenance), Specs
            per-vendor onest, PriceComparison single fee, FAQ, Disclaimer.
            Șterse: Plan, Trust, Testimonials, HowItWorks, Interpretation,
            Related. Spacing S1=gap-3 S2=gap-6 S3=gap-8, PY=py-10, type Display
            3xl / Section 2xl / Body sm. Fee: 30 lei Synevo/Invitro, 25 Alfa, 0
            Sante/MedExpert — single line, nu per-row 10–60.</CardDescription
          >
        </CardHeader>
        <CardContent
          className="flex flex-wrap gap-2 text-xs text-muted-foreground"
        >
          <Badge variant="outline">320px verificat</Badge>
          <Badge variant="outline">light ✓</Badge>
          <Badge variant="secondary">minimal 5 secțiuni</Badge>
          <Badge>175 lei honest</Badge>
          <Badge variant="outline">vendor_fees.json</Badge>
        </CardContent>
      </Card>
    </main>

    <footer
      class="mx-auto max-w-7xl px-4 pb-8 pt-2 text-xs text-muted-foreground sm:px-6"
    >
      Showcase minimal —
      <code class="rounded bg-muted px-1 py-0.5 font-mono">@workspace/ui</code>
      + 1:1 + useState · W2 price truth · 417 routes
    </footer>
  </body>
</html>
