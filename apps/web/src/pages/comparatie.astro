---
import { ComparisonPicker } from "../components/lists/ComparisonPicker";
import Layout from "../layouts/Layout.astro";
---

<Layout
  description="Compară analizele selectate — cel mai mic preț la un singur laborator, cu taxa de recoltare inclusă."
  lang="ro"
  title="Compară | Laborata"
>
  <section class="mx-auto w-full max-w-6xl px-4 py-6 sm:px-6 sm:py-8">
    <div class="flex flex-col gap-2">
      <h1 class="font-heading text-2xl font-semibold tracking-tight">
        Compară
      </h1>
      <p class="max-w-prose text-sm text-muted-foreground leading-relaxed">
        Alege 2–12 analize și vezi unde ieși cel mai ieftin — taxa de recoltare
        inclusă o singură dată.
      </p>
    </div>
    <div class="mt-6">
      <ComparisonPicker client:load />
    </div>
  </section>
</Layout>
