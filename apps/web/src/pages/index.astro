---
import { BundlesShelf } from "../components/home/bundles-shelf";
import { CatalogShelf } from "../components/home/catalog-shelf";
import { ConcernsRow } from "../components/home/concerns-row";
import { HeroSearch } from "../components/home/hero-search";
import { LabsTeaser } from "../components/home/labs-teaser";
import Layout from "../layouts/Layout.astro";
---

<Layout
  description="Comparație neutră 5 laboratoare, taxa o singură dată. Caută tsh fără diacritice, feritina → Feritină, glicemie ≡ glucoza."
  lang="ro"
  title="Găsește analizele potrivite, la preț corect — Laborata"
>
  <main class="flex w-full flex-col">
    <!-- Hero full-bleed -->
    <section class="w-full px-4 py-10 sm:px-6">
      <div class="mx-auto w-full max-w-7xl">
        <HeroSearch client:load />
      </div>
    </section>

    <!-- Concerns -->
    <section class="w-full px-4 sm:px-6">
      <div class="mx-auto w-full max-w-7xl">
        <ConcernsRow client:load />
      </div>
    </section>

    <!-- Common tests bento 1-2-3 -->
    <section class="w-full px-4 py-10 sm:px-6">
      <div class="mx-auto w-full max-w-7xl">
        <CatalogShelf client:load />
      </div>
    </section>

    <!-- Bundles -->
    <section class="w-full border-y bg-muted/20 px-4 py-10 sm:px-6">
      <div class="mx-auto w-full max-w-7xl">
        <BundlesShelf client:load />
      </div>
    </section>

    <!-- Labs + Map 12 mock -->
    <section class="w-full px-4 py-10 sm:px-6">
      <div class="mx-auto w-full max-w-7xl">
        <LabsTeaser client:load />
      </div>
    </section>

    <!-- Coming soon -->
    <section class="w-full px-4 pb-10 sm:px-6">
      <div class="mx-auto w-full max-w-7xl">
        <div class="rounded-xl border border-dashed bg-card p-6 text-center">
          <h2 class="font-heading text-base font-semibold">
            Soon you will book here.
          </h2>
          <p class="mx-auto max-w-prose text-sm text-muted-foreground">
            For now, write to
            <a
              class="underline underline-offset-4 hover:text-foreground"
              href="mailto:hello@laborata.md"
              >hello@laborata.md</a
            >.
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>
