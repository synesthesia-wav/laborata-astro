---
import { TESTS } from "@workspace/data/canonical";
import { BundlesShelf } from "../components/home/bundles-shelf";
import { CatalogShelf } from "../components/home/catalog-shelf";
import { ConcernsRow } from "../components/home/concerns-row";
import { HeroSearch } from "../components/home/hero-search";
import { LabsTeaser } from "../components/home/labs-teaser";
import {
  Card,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@workspace/ui/components/card";
import Layout from "../layouts/Layout.astro";

const site = "https://laborata.md";
const itemListLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Common tests — Laborata",
  itemListElement: TESTS.slice(0, 8).map((t, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: `${site}/analize/${t.slug_ro ?? t.id}`,
    name: t.name_ro ?? t.name_en ?? t.id,
  })),
};
const orgLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Laborata",
  url: site,
  logo: `${site}/favicon.svg`,
};
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Laboratoare",
      item: `${site}/laboratoare`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Harta",
      item: `${site}/harta`,
    },
  ],
};
---

<Layout
  description="Comparație neutră 5 laboratoare, taxa o singură dată. Caută tsh fără diacritice, feritina → Feritină, glicemie ≡ glucoza."
  lang="ro"
  title="Găsește analizele potrivite, la preț corect — Laborata"
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(orgLd)}
  />
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(itemListLd)}
  />
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbLd)}
  />
  <main class="flex w-full flex-col gap-(--gap) [--gap:--spacing(4)] md:[--gap:--spacing(10)]">
    <!-- Hero full-bleed -->
    <section class="w-full px-(--gap) py-[calc(var(--gap)*2)]">
      <div class="mx-auto w-full max-w-7xl">
        <HeroSearch client:load />
      </div>
    </section>

    <!-- Concerns -->
    <section class="w-full px-(--gap)">
      <div class="mx-auto w-full max-w-7xl">
        <ConcernsRow client:load />
      </div>
    </section>

    <!-- Common tests bento 1-2-3 -->
    <section class="w-full px-(--gap) py-[calc(var(--gap)*1.5)]">
      <div class="mx-auto w-full max-w-7xl">
        <CatalogShelf client:load />
      </div>
    </section>

    <!-- Bundles -->
    <section class="w-full bg-muted/10 px-(--gap) py-[calc(var(--gap)*1.5)]">
      <div class="mx-auto w-full max-w-7xl">
        <BundlesShelf client:load />
      </div>
    </section>

    <!-- Labs + Map -->
    <section class="w-full px-(--gap) py-[calc(var(--gap)*1.5)]">
      <div class="mx-auto w-full max-w-7xl">
        <LabsTeaser client:load />
      </div>
    </section>

    <!-- Coming soon -->
    <section class="w-full px-(--gap) pb-[calc(var(--gap)*2)]">
      <div class="mx-auto w-full max-w-7xl">
        <Card className="border-dashed">
          <CardHeader className="text-center">
            <CardTitle className="text-base">În curând poți rezerva aici.</CardTitle>
            <CardDescription>
              Deocamdată, scrie-ne la
              <a
                class="underline underline-offset-4 hover:text-foreground"
                href="mailto:hello@laborata.md"
                >hello@laborata.md</a
              >.
            </CardDescription>
          </CardHeader>
        </Card>
      </div>
    </section>
  </main>
</Layout>
