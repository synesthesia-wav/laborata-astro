---
import graph from "../../../../../packages/data/data/canonical-graph.json" with {
  type: "json",
};
import archetypes from "../../../../../packages/data/data/panel-archetypes-final-llm.json" with {
  type: "json",
};
import { BundleDetail } from "../../components/profil/BundleDetail";
import Layout from "../../layouts/Layout.astro";

interface GraphItem {
  id: string;
  member_count?: number;
  provenance?: { quorum?: number; total?: number }[];
  quorum_size?: number;
  referenceComponentIds?: string[];
  role: string;
  tuple_key: string;
  type: string;
  vendor_count: number;
  vendors: string[];
}

export function getStaticPaths() {
  const items = (graph as { items: GraphItem[] }).items.filter(
    (i) => i.type === "panel_archetype" && i.role === "comparison"
  );
  // 33 comparison panels
  return items.map((it) => ({ params: { slug: it.id } }));
}

const { slug } = Astro.params;
const item = (graph as { items: GraphItem[] }).items.find(
  (i) => i.id === slug
) as GraphItem | undefined;

if (!item) {
  return Astro.redirect("/analize", 302);
}

// enrich from panel-archetypes-final-llm.json for honest quorum/total
const arch = (
  archetypes as unknown as {
    id: string;
    quorum_size: number;
    total_comps: number;
    referenceComponentIds: string[];
  }[]
).find((a) => a.id === slug);

const referenceComponentIds =
  arch?.referenceComponentIds ?? item.referenceComponentIds ?? [];
const quorumSize =
  arch?.quorum_size ?? item.quorum_size ?? item.provenance?.[0]?.quorum ?? 0;
const totalComps =
  arch?.total_comps ??
  item.provenance?.[0]?.total ??
  referenceComponentIds.length;
const vendors = item.vendors ?? [];
const name = item.id
  .replace(/^arch-/, "")
  .replaceAll("-", " ")
  .replaceAll("+", " + ");
const displayName = name
  .split(" ")
  .map((w) => (w ? w[0].toUpperCase() + w.slice(1) : w))
  .join(" ");
const title = `${displayName} — Profil | Laborata`;
const description = `Profil ${displayName} — ${referenceComponentIds.length} analize. Vezi ce conține fiecare laborator și ce lipsește.`;
---

<Layout description={description} lang="ro" title={title}>
  <section class="mx-auto w-full max-w-3xl px-4 py-6 sm:px-6 sm:py-8">
    <div class="mb-4 flex items-center gap-2 text-xs text-muted-foreground">
      <a class="underline" href="/analize">Analize</a>
      <span>›</span>
      <span class="font-mono">{slug}</span>
    </div>
    <BundleDetail
      id={item.id}
      memberCount={item.member_count}
      name={displayName}
      quorumSize={quorumSize}
      referenceComponentIds={referenceComponentIds}
      totalComps={totalComps}
      vendorCount={item.vendor_count}
      vendors={vendors}
      client:load
    />
    <div
      class="mt-8 rounded-xl border bg-muted/20 p-4 text-xs leading-relaxed text-muted-foreground"
    >
      <p class="font-medium text-foreground">Despre pachet</p>
      <p>
        Afișăm 4/4 = tot pachetul la acel laborator, 0/4 = nu e pachet aici. Nu
        inventăm conținut — doar ce listează laboratoarele.
      </p>
      <p class="mt-2">
        Adaugă tot pachetul sau teste individual în liste (max. 12). Listele se
        salvează local și se partajează prin link.
      </p>
    </div>
  </section>
</Layout>
