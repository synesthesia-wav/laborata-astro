---
import { ListIndex } from "../../components/lists/ListIndex";
import Layout from "../../layouts/Layout.astro";
---

<Layout
  description="Liste de analize — salvează până la 12 teste și partajează printr-un link."
  lang="ro"
  title="Liste — Analizele mele | Laborata"
>
  <section class="mx-auto w-full max-w-5xl px-4 py-6 sm:px-6 sm:py-8">
    <div class="flex flex-col gap-2">
      <h1 class="font-heading text-2xl font-semibold tracking-tight">Liste</h1>
      <p class="max-w-prose text-sm text-muted-foreground leading-relaxed">
        Până la 12 teste per listă. Partajează linkul — se deschide și fără
        cont.
      </p>
    </div>
    <div class="mt-6">
      <ListIndex client:load />
    </div>
  </section>
</Layout>
