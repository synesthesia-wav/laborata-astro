---
import { getPricesForId } from "@workspace/data/prices";
import graph from "../../../../../packages/data/data/canonical-graph.json" with {
  type: "json",
};
import { PRODUCT_GALLERY } from "../../components/product/data";
import { Faq } from "../../components/product/faq";
import { PriceComparison } from "../../components/product/price-comparison";
import { ProductGallery } from "../../components/product/product-gallery";
import { ProductHeader } from "../../components/product/product-header";
import { ProductSpecs } from "../../components/product/product-specs";
import Layout from "../../layouts/Layout.astro";

interface GraphItem {
  id: string;
  name_ro?: string;
  role: string;
  tuple_key: string;
}

export function getStaticPaths() {
  const items = (graph as { items: GraphItem[] }).items.filter(
    (i) => i.role === "comparison"
  );
  return items.map((it) => ({ params: { slug: it.id } }));
}

const { slug } = Astro.params;
const item = (graph as { items: GraphItem[] }).items.find((i) => i.id === slug);
if (!item) {
  return Astro.redirect("/analize/vitamina-b12", 302);
}

const rawName = (item as GraphItem).name_ro ?? slug.replaceAll("-", " ");
const displayName =
  slug === "vitamina-b12" ? "Vitamina B12 (Cobalamină)" : rawName;
const compactName = slug === "vitamina-b12" ? "Vitamina B12" : rawName;
const LAB_LABEL: Record<string, string> = {
  alfa: "Alfa",
  invitro: "Invitro",
  medexpert: "MedExpert",
  sante: "Sante",
  synevo: "Synevo",
};
const rawPrices = getPricesForId(slug);
const priceOffers = (rawPrices ?? []).map((o) => ({
  lab: LAB_LABEL[o.vendor] ?? o.vendor,
  price_mdl: o.price_mdl,
  sourceUrl: o.sourceUrl,
  variant: o.variant,
  vendor: o.vendor,
}));
const cheapestMdl =
  priceOffers.length > 0
    ? Math.min(...priceOffers.map((o) => o.price_mdl))
    : null;
const primarySourceUrl =
  rawPrices?.[0]?.sourceUrl ??
  "https://www.invitro.md/ro/services/prelevarea-sangelui-venos";
const tupleSpecimen = (item as GraphItem).tuple_key.split("|")[2] || null;
const sampleTypeRaw = rawPrices?.[0]?.specimen ?? (tupleSpecimen && tupleSpecimen.trim() ? tupleSpecimen : null);
const turnaroundRaw = rawPrices?.[0]?.turnaround ?? null;
const title = `${displayName} | Laborata — Analize`;
const description =
  slug === "vitamina-b12"
    ? `Vitamina B12 (Cobalamină). Măsoară B12 total circulant, rezultat în 1 zi, de la ${cheapestMdl ?? 166} lei. Comparație prețuri Synevo, Sante, Invitro, Alfa.`
    : `${displayName} — analiză disponibilă la partenerii Laborata. Compară prețuri, taxa de recoltare o singură dată.`;
const url = new URL(
  Astro.url.pathname,
  Astro.site ?? Astro.url.origin
).toString();
---

<Layout
  description={description}
  lang="ro"
  ogImage={PRODUCT_GALLERY[0]}
  title={title}
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "MedicalTest",
      name: displayName,
      alternateName: slug,
      description,
      url,
      relevantSpecialty: "Laboratory",
      code: {
        "@type": "MedicalCode",
        code: (item as GraphItem).tuple_key,
        codingSystem: "Laborata tuple_key",
      },
    })}
  />
  <!-- Hero: gallery + header -->
  <section
    class="grid gap-8 px-4 py-6 sm:px-6 sm:py-8 lg:grid-cols-[1.05fr_0.95fr] lg:gap-10"
  >
    <ProductGallery
      idSuffix={`${slug}-hero`}
      images={PRODUCT_GALLERY}
      client:load
    />
    <ProductHeader
      idSuffix={`${slug}-hero`}
      lang="ro"
      name={displayName}
      lowestPrice={cheapestMdl}
      priceAsOf="august 2026"
      sampleType={sampleTypeRaw}
      sourceUrl={primarySourceUrl}
      turnaround={turnaroundRaw}
      client:load
    />
  </section>

  <!-- Specs -->
  <section class="border-t bg-muted/20 px-4 py-10 sm:px-6">
    <div class="mx-auto flex w-full max-w-7xl flex-col">
      <ProductSpecs idSuffix={`${slug}-specs`} name={displayName} client:load />
    </div>
  </section>

  <!-- Price comparison -->
  <section class="px-4 py-10 sm:px-6">
    <div class="mx-auto w-full max-w-7xl">
      <PriceComparison
        idSuffix={slug}
        lang="ro"
        offers={priceOffers}
        priceAsOf="august 2026"
        client:load
      />
    </div>
  </section>

  <!-- FAQ -->
  <section class="px-4 py-10 sm:px-6">
    <div class="mx-auto w-full max-w-3xl">
      <Faq idSuffix={slug} name={compactName} client:load />
    </div>
  </section>

  <!-- Disclaimer -->
  <section class="border-t bg-card px-4 py-8 sm:px-6">
    <div class="mx-auto max-w-7xl">
      <p class="max-w-3xl text-xs leading-relaxed text-muted-foreground">
        Informațiile oferite de Laborata au scop informativ și nu înlocuiesc
        consultul medical. Pentru simptome persistente, anemie, sarcină sau
        tratament cu suplimente, consultă medicul. Produsul prezentat nu include
        B12 activă (holotranscobalamină), MMA sau homocisteină — recomandăm
        testele conexe pentru context funcțional. Taxa recoltare:
        Sante/MedExpert 0 lei — inclus, Synevo/Invitro 30 lei o singură dată,
        Alfa 25 lei.
      </p>
    </div>
  </section>
</Layout>
