---
import { AnalizeBrowse } from "../../components/analize/AnalizeBrowse";
import Layout from "../../layouts/Layout.astro";
---

<Layout
  description="Caută fără diacritice (tsh, feritina) și compară 417 analize la 5 laboratoare. Filtrează după tip probă și laborator."
  lang="ro"
  title="Analize | Laborata"
>
  <section class="mx-auto w-full max-w-7xl px-4 py-6 sm:px-6 sm:py-8">
    <div class="flex flex-col gap-2">
      <h1 class="font-heading text-2xl font-semibold tracking-tight">
        Analize
      </h1>
      <p class="max-w-prose text-sm text-muted-foreground leading-relaxed">
        Până la 417 analize comparabile. Caută
        <span class="font-medium text-foreground">tsh</span>,
        <span class="font-medium text-foreground">feritina</span>
        →
        <span class="font-medium text-foreground">Feritină</span>,
        <span class="font-medium text-foreground">glicemie</span>
        =
        <span class="font-medium text-foreground">glucoză</span>
        — fără diacritice, cu potrivire inteligentă.
      </p>
    </div>
    <div class="mt-6">
      <AnalizeBrowse client:load />
    </div>
  </section>
</Layout>
