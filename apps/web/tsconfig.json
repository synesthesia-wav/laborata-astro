{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/*": ["./src/*"],
      "@workspace/blocks/*": ["../../packages/blocks/src/*"],
      "@workspace/ui/*": ["../../packages/ui/src/*"]
    },
    "strictNullChecks": true
  }
}
