---
interface Props {
  description?: string;
  id: string;
  title: string;
  // width constraint for 320px testing — when set, frame is clamped so overflow is visible
  width?: string;
}

const { id, title, description, width } = Astro.props;
---

<section
  class="flex flex-col gap-3 rounded-xl border bg-card p-4 shadow-sm"
  data-state-frame={id}
  id={id}
  style={width ? `max-width:${width}; width:100%` : undefined}
>
  <div class="flex flex-col gap-1">
    <h3 class="font-heading text-sm font-medium tracking-tight">{title}</h3>
    {description && <p class="text-xs leading-relaxed text-muted-foreground">{description}</p>}
    <span class="font-mono text-[10px] text-muted-foreground/70">{id}</span>
  </div>
  <div class="min-w-0 rounded-lg border border-dashed bg-background p-4">
    <slot />
  </div>
</section>
