---
import "@workspace/ui/globals.css";

interface Props {
  description?: string;
  title?: string;
}

const {
  title = "UI Playground — Showcase",
  description = "Single-grid stress matrix for @workspace/ui primitives. Semantic tokens only, gap-based layout, 320px-safe.",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1" name="viewport">
    <meta content={description} name="description">
    <link href="/favicon.svg" rel="icon" type="image/svg+xml">
    <title>{title}</title>
    <script is:inline>
      // Minimal dark toggle — persists, matches shadscan theme-provider expectations for manual verification
      const key = "ui-playground-theme";
      const apply = (v) =>
        document.documentElement.classList.toggle("dark", v === "dark");
      apply(
        localStorage.getItem(key) ||
          (matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light")
      );
      document.addEventListener("DOMContentLoaded", () => {
        const btn = document.getElementById("theme-toggle");
        if (!btn) {
          return;
        }
        btn.addEventListener("click", () => {
          const next = document.documentElement.classList.contains("dark")
            ? "light"
            : "dark";
          localStorage.setItem(key, next);
          apply(next);
        });
        document.addEventListener("keydown", (e) => {
          const t = e.target;
          const isTyping =
            t instanceof HTMLElement &&
            (t.tagName === "INPUT" ||
              t.tagName === "TEXTAREA" ||
              t.tagName === "SELECT" ||
              t.isContentEditable);
          if (isTyping) {
            return;
          }
          if (
            e.key === "d" ||
            (e.key.toLowerCase() === "d" &&
              (e.metaKey || e.ctrlKey) &&
              e.shiftKey)
          ) {
            e.preventDefault();
            btn.click();
          }
        });
      });
    </script>
  </head>
  <body class="bg-background text-foreground antialiased">
    <header class="sticky top-0 z-10 border-b bg-background/80 backdrop-blur">
      <div
        class="mx-auto flex max-w-[1600px] items-center justify-between gap-4 px-4 py-3 sm:px-6"
      >
        <div class="min-w-0">
          <h1
            class="truncate font-heading text-sm font-semibold tracking-tight"
          >
            UI Playground
          </h1>
          <p class="truncate text-xs text-muted-foreground">
            Single showcase grid — every state side-by-side. Real components,
            real tokens.
          </p>
        </div>
        <div class="flex shrink-0 items-center gap-2">
          <span class="hidden text-xs text-muted-foreground sm:inline"
            >Press
            <kbd
              class="rounded border bg-muted px-1 py-0.5 font-mono text-[10px]"
              >d</kbd
            >
            to toggle theme</span
          >
          <button
            class="inline-flex h-8 items-center rounded-lg border bg-card px-3 text-xs font-medium hover:bg-muted"
            id="theme-toggle"
            type="button"
          >
            Toggle theme
          </button>
        </div>
      </div>
    </header>
    <main class="mx-auto w-full max-w-[1600px] min-w-0 p-4 sm:p-6">
      <slot />
    </main>
    <footer
      class="mx-auto max-w-[1600px] px-4 pb-8 pt-2 text-xs text-muted-foreground sm:px-6"
    >
      Tokens via
      <code class="rounded bg-muted px-1 py-0.5 font-mono">
        @workspace/ui/globals.css</code
      >
      — no <code>dark:</code> overrides, no arbitrary colors, no
      <code>space-x/y</code>.
    </footer>
  </body>
</html>
